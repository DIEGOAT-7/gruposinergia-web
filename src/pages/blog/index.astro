---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const featured = posts.find(p => p.data.featured)
const rest     = posts.filter(p => !p.data.featured)

function formatDate(date: Date) {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })
}

function slug(id: string) {
  return id.replace(/\.md$/, '')
}
---

<Layout
  title="Blog"
  description="Artículos sobre Propiedad Horizontal, Derecho Urbano e Inmobiliario. Orientación jurídica y técnica para administradores y copropietarios en Colombia."
>

  <!-- ══════════════════════════════════════════
       PAGE HERO
  ══════════════════════════════════════════ -->
  <section class="bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="absolute -top-20 right-0 w-96 h-96 rounded-full bg-accent-500 opacity-[0.05] blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-32">
      <p class="text-accent-500 text-xs font-semibold uppercase tracking-[0.15em] mb-4">Conocimiento especializado</p>
      <h1 class="font-heading text-white text-5xl sm:text-6xl font-bold leading-tight mb-6">Blog</h1>
      <div class="w-14 h-0.5 bg-accent-500 mb-6"></div>
      <p class="text-neutral-300 text-lg max-w-xl leading-relaxed">
        Artículos sobre Propiedad Horizontal, derecho urbano e inmobiliario
        para administradores, copropietarios y profesionales del sector.
      </p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       ARTÍCULO DESTACADO
  ══════════════════════════════════════════ -->
  {featured && (
    <section class="py-16 bg-white border-b border-neutral-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-accent-600 text-xs font-semibold uppercase tracking-[0.15em] mb-8">Artículo destacado</p>

        <a href={`/blog/${slug(featured.id)}`} class="group grid lg:grid-cols-5 gap-10 items-center">
          <!-- Decorative block -->
          <div class="lg:col-span-2 bg-brand-800 rounded-2xl p-10 aspect-[4/3] flex flex-col justify-between">
            <span class="inline-block bg-accent-500 text-brand-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide w-fit">
              {featured.data.category}
            </span>
            <p class="font-heading text-white text-3xl font-bold leading-tight opacity-20 select-none">
              Propiedad<br />Horizontal
            </p>
          </div>

          <!-- Copy -->
          <div class="lg:col-span-3">
            <span class="text-neutral-400 text-xs mb-3 block">{formatDate(featured.data.pubDate)}</span>
            <h2 class="font-heading text-brand-900 text-3xl font-bold leading-snug mb-4 group-hover:text-brand-600 transition-colors">
              {featured.data.title}
            </h2>
            <p class="text-neutral-500 leading-relaxed mb-6">{featured.data.description}</p>
            <span class="inline-flex items-center gap-2 text-brand-700 font-semibold text-sm group-hover:gap-3 transition-all">
              Leer artículo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}


  <!-- ══════════════════════════════════════════
       TODOS LOS ARTÍCULOS
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-neutral-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      {rest.length > 0 && (
        <>
          <h2 class="font-heading text-brand-900 text-2xl font-bold mb-10">Más artículos</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map(post => (
              <a
                href={`/blog/${slug(post.id)}`}
                class="group bg-white rounded-xl border border-neutral-200 overflow-hidden hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 flex flex-col"
              >
                <!-- Color bar -->
                <div class="h-1.5 bg-brand-800"></div>

                <div class="p-7 flex flex-col flex-1">
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-semibold text-accent-600 uppercase tracking-wide">
                      {post.data.category}
                    </span>
                    <span class="text-xs text-neutral-400">{formatDate(post.data.pubDate)}</span>
                  </div>
                  <h3 class="font-heading text-brand-900 font-semibold leading-snug mb-3 group-hover:text-brand-600 transition-colors flex-1">
                    {post.data.title}
                  </h3>
                  <p class="text-neutral-500 text-sm leading-relaxed line-clamp-3 mb-5">
                    {post.data.description}
                  </p>
                  <span class="inline-flex items-center gap-1.5 text-brand-700 text-sm font-semibold group-hover:gap-2.5 transition-all mt-auto">
                    Leer más
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}

      {posts.length === 0 && (
        <p class="text-neutral-400 text-center py-20">Próximamente — el primer artículo está en camino.</p>
      )}

    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA SUSCRIPCIÓN / CONTACTO
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-white text-3xl font-bold mb-4">
        ¿Su caso requiere más que un artículo?
      </h2>
      <p class="text-neutral-300 mb-8">
        Nuestro equipo está disponible para asesoría personalizada. La consulta inicial no tiene costo.
      </p>
      <a
        href="/contacto"
        class="inline-block px-8 py-4 bg-accent-500 text-brand-900 font-semibold rounded hover:bg-accent-400 transition-colors"
      >
        Solicitar asesoría
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 24px,
      rgba(255, 255, 255, 0.025) 24px,
      rgba(255, 255, 255, 0.025) 25px
    );
  }
</style>
