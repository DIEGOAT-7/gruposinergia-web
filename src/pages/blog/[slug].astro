---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props:  { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

function formatDate(date: Date) {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<Layout title={post.data.title} description={post.data.description}>

  <!-- ══════════════════════════════════════════
       PAGE HERO
  ══════════════════════════════════════════ -->
  <section class="bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="absolute -top-20 right-0 w-96 h-96 rounded-full bg-accent-500 opacity-[0.05] blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-28">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-neutral-400 mb-8">
        <a href="/blog" class="hover:text-accent-500 transition-colors">Blog</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-neutral-300 truncate max-w-xs">{post.data.title}</span>
      </nav>

      <span class="inline-block bg-accent-500 text-brand-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide mb-6">
        {post.data.category}
      </span>

      <h1 class="font-heading text-white text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight mb-6">
        {post.data.title}
      </h1>

      <div class="flex items-center gap-4 text-sm text-neutral-400">
        <span>{post.data.author}</span>
        <span class="w-1 h-1 rounded-full bg-neutral-600"></span>
        <span>{formatDate(post.data.pubDate)}</span>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CONTENIDO
  ══════════════════════════════════════════ -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_280px] gap-16 items-start">

        <!-- Artículo -->
        <article class="prose-article">
          <Content />
        </article>

        <!-- Sidebar -->
        <aside class="space-y-6 lg:sticky lg:top-28">

          <!-- CTA -->
          <div class="bg-brand-800 rounded-2xl p-7">
            <p class="font-heading text-white font-semibold text-lg mb-3 leading-snug">
              ¿Necesita asesoría personalizada?
            </p>
            <p class="text-neutral-300 text-sm leading-relaxed mb-5">
              Nuestro equipo está disponible para orientarle en su caso específico.
              La consulta inicial no tiene costo.
            </p>
            <a
              href="/contacto"
              class="block text-center px-5 py-3 bg-accent-500 text-brand-900 font-semibold rounded-lg text-sm hover:bg-accent-400 transition-colors"
            >
              Contactar ahora
            </a>
          </div>

          <!-- Servicios relacionados -->
          <div class="bg-neutral-50 rounded-2xl p-7 border border-neutral-100">
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-neutral-400 mb-4">Servicios relacionados</p>
            <ul class="space-y-2">
              {[
                { label: 'Recibo de Zonas Comunes', href: '/servicios/recibo-zonas-comunes' },
                { label: 'Asesoría en Propiedad Horizontal', href: '/servicios' },
                { label: 'Derecho Urbano', href: '/servicios' },
                { label: 'Reglamentos de PH', href: '/servicios' },
              ].map(s => (
                <li>
                  <a
                    href={s.href}
                    class="text-sm text-brand-700 hover:text-brand-900 font-medium inline-flex items-center gap-1.5 transition-colors"
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Volver al blog -->
          <a
            href="/blog"
            class="flex items-center gap-2 text-sm text-neutral-500 hover:text-brand-700 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Volver al blog
          </a>
        </aside>

      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 24px,
      rgba(255, 255, 255, 0.025) 24px,
      rgba(255, 255, 255, 0.025) 25px
    );
  }

  /* Tipografía del artículo — usa variables CSS de Tailwind v4 */
  .prose-article {
    color: var(--color-neutral-700);
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose-article h2 {
    font-family: var(--font-heading);
    color: var(--color-brand-900);
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose-article h3 {
    font-family: var(--font-heading);
    color: var(--color-brand-800);
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-article p {
    margin-bottom: 1.25rem;
  }

  .prose-article ul,
  .prose-article ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose-article li {
    margin-bottom: 0.4rem;
  }

  .prose-article ul li {
    list-style-type: disc;
  }

  .prose-article ol li {
    list-style-type: decimal;
  }

  .prose-article strong {
    color: var(--color-brand-800);
    font-weight: 600;
  }

  .prose-article hr {
    border-color: var(--color-neutral-200);
    margin: 2rem 0;
  }

  .prose-article a {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-article a:hover {
    color: var(--color-brand-900);
  }
</style>
