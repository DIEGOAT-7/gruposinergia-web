---
import Layout from '../layouts/Layout.astro'

const services = [
  {
    slug: 'derecho-urbano',
    title: 'Derecho Urbano',
    summary: 'Asesoría jurídica en normas de ordenamiento territorial, uso del suelo y regulaciones urbanas aplicables a copropiedades.',
    detail: [
      'Interpretación y aplicación de normas de ordenamiento territorial (POT/EOT).',
      'Asesoría en licencias de construcción, urbanización y subdivisión.',
      'Gestión ante entidades de control urbanístico.',
      'Conceptos jurídicos sobre uso del suelo en conjuntos residenciales y comerciales.',
      'Acompañamiento en procesos administrativos ante Planeación Municipal.',
    ],
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    slug: 'derecho-inmobiliario',
    title: 'Derecho Inmobiliario',
    summary: 'Gestión jurídica integral de bienes inmuebles: contratos, escrituras, tradición y procesos relacionados con la propiedad.',
    detail: [
      'Revisión y redacción de contratos de compraventa, arrendamiento y promesas.',
      'Estudio de títulos y certificados de tradición y libertad.',
      'Asesoría en procesos de sucesión y adjudicación de inmuebles.',
      'Trámites ante notarías y Oficinas de Registro de Instrumentos Públicos.',
      'Consultoría en régimen de propiedad horizontal desde la perspectiva inmobiliaria.',
    ],
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    slug: 'asesoria-propiedad-horizontal',
    title: 'Asesoría en Propiedad Horizontal',
    summary: 'Consultoría especializada para administradores, consejos de administración y copropietarios en todos los aspectos del régimen de PH.',
    detail: [
      'Interpretación de la Ley 675 de 2001 y normas complementarias.',
      'Asesoría en convocatoria y desarrollo de asambleas de copropietarios.',
      'Orientación a administradores en gestión operativa y jurídica.',
      'Consultoría a revisores fiscales y contadores en PH.',
      'Resolución de conflictos entre copropietarios y órganos de administración.',
    ],
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    slug: 'reglamento-propiedad-horizontal',
    title: 'Reglamento de Propiedad Horizontal',
    summary: 'Elaboración, revisión y actualización de reglamentos de copropiedad conforme a la legislación vigente y las necesidades del proyecto.',
    detail: [
      'Redacción de reglamentos para proyectos de vivienda, comercio y uso mixto.',
      'Revisión y actualización de reglamentos existentes desactualizados.',
      'Adecuación a la Ley 675 de 2001 y demás normativas aplicables.',
      'Definición de coeficientes de copropiedad y módulos de contribución.',
      'Asesoría en el proceso de protocolización ante notaría.',
    ],
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    slug: 'responsabilidad-civil',
    title: 'Responsabilidad Civil',
    summary: 'Defensa y representación en procesos de responsabilidad civil originados en el ámbito de copropiedades y propiedad horizontal.',
    detail: [
      'Representación en reclamaciones por daños en zonas comunes.',
      'Asesoría en responsabilidad de administradores y miembros del consejo.',
      'Gestión ante aseguradoras por pólizas de responsabilidad civil.',
      'Procesos por incumplimiento de obligaciones entre constructores y copropietarios.',
      'Conciliación extrajudicial y representación en etapas judiciales.',
    ],
    icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  },
]
---

<Layout
  title="Servicios"
  description="Servicios especializados en Propiedad Horizontal: Recibo de Zonas Comunes, Derecho Urbano, Derecho Inmobiliario, Asesoría en PH, Reglamentos y Responsabilidad Civil."
>

  <!-- ══════════════════════════════════════════
       PAGE HERO
  ══════════════════════════════════════════ -->
  <section class="bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="absolute -top-20 right-0 w-96 h-96 rounded-full bg-accent-500 opacity-[0.05] blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <p class="text-accent-500 text-xs font-semibold uppercase tracking-[0.15em] mb-4">Lo que ofrecemos</p>
      <h1 class="font-heading text-white text-5xl sm:text-6xl font-bold leading-tight mb-6">
        Nuestros Servicios
      </h1>
      <div class="w-14 h-0.5 bg-accent-500 mb-6"></div>
      <p class="text-neutral-300 text-lg max-w-xl leading-relaxed">
        Seis áreas de práctica integradas bajo un solo equipo interdisciplinario,
        para dar respuesta completa a cada necesidad de su copropiedad.
      </p>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       SERVICIO ESTRELLA — RECIBO DE ZONAS COMUNES
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-white border-b border-neutral-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid lg:grid-cols-2 gap-12 items-center">

        <!-- Left: copy -->
        <div>
          <div class="inline-flex items-center gap-2 bg-accent-500 text-brand-900 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide mb-6">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Servicio estrella
          </div>

          <h2 class="font-heading text-brand-900 text-4xl font-bold leading-tight mb-5">
            Recibo de Zonas Comunes<br />al Constructor
          </h2>
          <div class="w-14 h-0.5 bg-accent-500 mb-7"></div>

          <p class="text-neutral-600 leading-relaxed mb-5">
            El proceso de recibo de zonas comunes es el momento más crítico para una copropiedad.
            Es la única oportunidad de documentar, exigir y formalizar el cumplimiento de lo prometido
            por el constructor antes de que la responsabilidad quede disuelta.
          </p>
          <p class="text-neutral-600 leading-relaxed mb-8">
            Nuestro equipo realiza una auditoría técnica y jurídica integral que evalúa el estado real
            de las zonas comunes frente a las especificaciones de la promesa de compraventa, los planos
            aprobados y la normativa vigente — acompañando a la copropiedad desde la inspección hasta
            el acuerdo conciliatorio con el constructor.
          </p>

          <a
            href="/servicios/recibo-zonas-comunes"
            class="inline-flex items-center gap-2 px-7 py-3.5 bg-brand-800 text-white font-semibold rounded hover:bg-brand-700 transition-colors"
          >
            Ver página completa del servicio
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Right: proceso -->
        <div class="bg-brand-800 rounded-2xl p-8">
          <p class="text-accent-500 text-xs font-semibold uppercase tracking-[0.15em] mb-6">Nuestro proceso</p>
          <ol class="space-y-0">
            {[
              'Revisión de documentos (promesa, planos, especificaciones)',
              'Inspección técnica de zonas comunes con ingenieros especializados',
              'Elaboración del informe técnico-jurídico de hallazgos',
              'Notificación formal al constructor',
              'Acompañamiento en la negociación y acuerdo conciliatorio',
            ].map((step, i) => (
              <li class:list={[
                'flex gap-4 py-4',
                i < 4 ? 'border-b border-brand-700' : ''
              ]}>
                <span class="font-heading text-accent-500 text-lg font-bold leading-none mt-0.5 w-6 shrink-0">
                  {i + 1}
                </span>
                <span class="text-neutral-300 text-sm leading-relaxed">{step}</span>
              </li>
            ))}
          </ol>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       OTROS SERVICIOS
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-neutral-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-14">
        <p class="text-accent-600 text-xs font-semibold uppercase tracking-[0.15em] mb-3">Áreas de práctica</p>
        <h2 class="font-heading text-brand-900 text-4xl font-bold">Servicios Complementarios</h2>
        <div class="w-14 h-0.5 bg-accent-500 mt-4"></div>
      </div>

      <div class="space-y-6">
        {services.map((s, i) => (
          <div class="group bg-white rounded-xl border border-neutral-200 border-l-4 border-l-brand-800 overflow-hidden hover:shadow-md transition-shadow duration-200">
            <div class="p-8">
              <div class="grid lg:grid-cols-3 gap-8 items-start">

                <!-- Icon + title + summary -->
                <div class="lg:col-span-1">
                  <div class="flex items-start gap-4">
                    <div class="w-11 h-11 bg-brand-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                      <svg class="w-5 h-5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon}/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-heading text-brand-900 text-xl font-semibold mb-2 leading-snug">{s.title}</h3>
                      <p class="text-neutral-500 text-sm leading-relaxed">{s.summary}</p>
                    </div>
                  </div>
                </div>

                <!-- Detail list -->
                <div class="lg:col-span-2">
                  <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2">
                    {s.detail.map(item => (
                      <li class="flex items-start gap-2 text-sm text-neutral-600">
                        <span class="text-accent-600 mt-1 shrink-0">
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                        </span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>

              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-white text-4xl font-bold mb-4">
        ¿No sabe cuál servicio necesita?
      </h2>
      <p class="text-neutral-300 mb-8 text-lg">
        Cuéntenos su situación y le orientamos sin costo hacia la solución correcta.
      </p>
      <a
        href="/contacto"
        class="inline-block px-8 py-4 bg-accent-500 text-brand-900 font-semibold rounded hover:bg-accent-400 transition-colors"
      >
        Solicitar orientación gratuita
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 24px,
      rgba(255, 255, 255, 0.025) 24px,
      rgba(255, 255, 255, 0.025) 25px
    );
  }
</style>
