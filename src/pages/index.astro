---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import heroImg from '../assets/hero-ciudad.jpg'

const services = [
  {
    title: 'Derecho Urbano',
    desc: 'Asesoría jurídica especializada en normativa urbana aplicable a copropiedades y conjuntos residenciales.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    title: 'Derecho Inmobiliario',
    desc: 'Gestión jurídica de bienes inmuebles, contratos, escrituras y procesos relacionados con la propiedad.',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    title: 'Asesoría en Propiedad Horizontal',
    desc: 'Consultoría para administradores, consejos y copropietarios en todos los aspectos del régimen de PH.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Reglamento de Propiedad Horizontal',
    desc: 'Elaboración, revisión y actualización de reglamentos de copropiedad conforme a la legislación vigente.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: 'Responsabilidad Civil',
    desc: 'Defensa y representación en procesos de responsabilidad civil derivados de la actividad en copropiedades.',
    icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  },
]

const stats = [
  { value: '15+',      label: 'Años de experiencia' },
  { value: '6',        label: 'Áreas de práctica' },
  { value: '100%',     label: 'Dedicación por caso' },
  { value: 'Nacional', label: 'Cobertura' },
]

const differentiators = [
  {
    title: 'Equipo Interdisciplinario',
    desc: 'Derecho, Administración, Contaduría e Ingeniería trabajando como un solo equipo.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Especialista por Área',
    desc: 'Cada aspecto del proceso tiene un profesional dedicado exclusivamente a esa área.',
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  },
  {
    title: 'Acompañamiento Completo',
    desc: 'Desde la auditoría técnica hasta el acuerdo conciliatorio, estamos con usted en cada etapa.',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
  },
]
---

<Layout title="Inicio">

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="relative min-h-screen bg-brand-800 flex items-center overflow-hidden">

    <!-- Foto de fondo -->
    <Image
      src={heroImg}
      alt="Vista aérea de ciudad colombiana"
      widths={[768, 1280, 2000]}
      sizes="100vw"
      format="webp"
      quality={62}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover opacity-[0.35]"
    />
    <div class="absolute inset-0 bg-brand-800/80"></div>

    <!-- Diagonal line pattern -->
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>

    <!-- Ambient glows -->
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-accent-500 opacity-[0.06] blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-brand-600 opacity-20 blur-2xl pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28 w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: copy -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2.5 bg-brand-700 border border-brand-600 rounded-full px-4 py-1.5 mb-8">
            <span class="w-2 h-2 rounded-full bg-accent-500 shrink-0"></span>
            <span class="text-neutral-200 text-xs tracking-widest uppercase font-medium">
              Especialistas en Propiedad Horizontal
            </span>
          </div>

          <h1 class="font-heading text-white text-4xl sm:text-5xl lg:text-[3.4rem] font-bold leading-[1.15] mb-6">
            Asesoría Jurídica<br />
            y <span class="text-accent-500">Técnica</span><br />
            para Copropiedades
          </h1>

          <p class="text-neutral-300 text-lg leading-relaxed mb-10 max-w-md">
            Equipo interdisciplinario de Derecho, Administración, Contaduría e Ingeniería
            al servicio de su copropiedad.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="/servicios"
              class="px-7 py-3.5 bg-accent-500 text-brand-900 font-semibold rounded text-sm hover:bg-accent-400 transition-colors"
            >
              Conocer servicios
            </a>
            <a
              href="/contacto"
              class="px-7 py-3.5 border border-white/60 text-white font-semibold rounded text-sm hover:bg-brand-700 hover:border-white transition-colors"
            >
              Contáctenos
            </a>
          </div>
        </div>

        <!-- Right: stats grid -->
        <div class="grid grid-cols-2 gap-4">
          {stats.map(s => (
            <div class="bg-brand-700/60 border border-brand-600 rounded-xl p-6 backdrop-blur-sm">
              <p class="font-heading text-accent-500 text-4xl font-bold mb-1 leading-none">{s.value}</p>
              <p class="text-neutral-300 text-sm mt-2">{s.label}</p>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white/5 to-transparent pointer-events-none"></div>
  </section>


  <!-- ══════════════════════════════════════════
       SERVICIOS
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-14">
        <p class="text-accent-600 text-xs font-semibold uppercase tracking-[0.15em] mb-3">Lo que ofrecemos</p>
        <h2 class="font-heading text-brand-900 text-4xl font-bold">Nuestros Servicios</h2>
        <div class="w-14 h-0.5 bg-accent-500 mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Flagship card -->
        <div class="relative bg-brand-800 rounded-xl p-8 flex flex-col row-span-1">
          <span class="absolute top-5 right-5 bg-accent-500 text-brand-900 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wide">
            Servicio estrella
          </span>

          <div class="w-12 h-12 bg-brand-700 rounded-lg flex items-center justify-center mb-6 shrink-0">
            <svg class="w-6 h-6 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>

          <h3 class="font-heading text-white text-xl font-semibold mb-3 leading-snug pr-4">
            Recibo de Zonas Comunes al Constructor
          </h3>
          <p class="text-neutral-300 text-sm leading-relaxed flex-1">
            Auditoría técnica y jurídica integral de las zonas comunes para garantizar el cumplimiento
            de las condiciones pactadas en la promesa de compraventa.
          </p>
          <a
            href="/servicios/recibo-zonas-comunes"
            class="mt-6 inline-flex items-center gap-2 text-accent-500 text-sm font-semibold group"
          >
            Conocer más
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
        <!-- Flagship card 2 -->
        <div class="relative bg-brand-900 rounded-xl p-8 flex flex-col row-span-1">
          <span class="absolute top-5 right-5 bg-accent-500 text-brand-900 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wide">
            Servicio estrella
          </span>

          <div class="w-12 h-12 bg-brand-800 rounded-lg flex items-center justify-center mb-6 shrink-0">
            <svg class="w-6 h-6 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <h3 class="font-heading text-white text-xl font-semibold mb-3 leading-snug pr-4">
            Cuantificación de Daños por Sismo
          </h3>
          <p class="text-neutral-300 text-sm leading-relaxed flex-1">
            Inspección y cuantificación técnica de daños en áreas comunes y privadas tras un sismo,
            para sustentar la reclamación ante la aseguradora.
          </p>
          <a
            href="/servicios"
            class="mt-6 inline-flex items-center gap-2 text-accent-500 text-sm font-semibold group"
          >
            Conocer más
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Other service cards -->
        {services.map(s => (
          <div class="group bg-white border border-neutral-200 border-l-4 border-l-brand-800 rounded-xl p-8 flex flex-col hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
            <div class="w-11 h-11 bg-brand-50 rounded-lg flex items-center justify-center mb-5 shrink-0">
              <svg class="w-5 h-5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={s.icon} />
              </svg>
            </div>
            <h3 class="font-heading text-brand-900 text-lg font-semibold mb-3 leading-snug">{s.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed flex-1">{s.desc}</p>
            <a
              href="/servicios"
              class="mt-5 text-brand-700 text-sm font-semibold inline-flex items-center gap-1.5 group-hover:gap-3 transition-all"
            >
              Ver detalle
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))}

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       PROPUESTA DE VALOR
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-brand-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-14">
        <p class="text-accent-600 text-xs font-semibold uppercase tracking-[0.15em] mb-3">Nuestra diferencia</p>
        <h2 class="font-heading text-brand-900 text-4xl font-bold">¿Por qué elegirnos?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {differentiators.map(item => (
          <div class="bg-white rounded-xl p-8 shadow-sm border border-neutral-100">
            <div class="w-14 h-14 bg-brand-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-heading text-brand-900 text-xl font-semibold mb-3">{item.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       QUIÉNES SOMOS SNIPPET
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: text -->
        <div>
          <p class="text-accent-600 text-xs font-semibold uppercase tracking-[0.15em] mb-3">Nuestra historia</p>
          <h2 class="font-heading text-brand-900 text-4xl font-bold mb-6 leading-tight">
            Más de 15 años<br />de experiencia
          </h2>
          <div class="w-14 h-0.5 bg-accent-500 mb-8"></div>
          <p class="text-neutral-600 leading-relaxed mb-4">
            GRUPO SINERGIA CONSULTORES S.A.S. es el producto de más de veinticinco años de experiencia,
            creada pensando en las necesidades propias del régimen de Propiedad Horizontal en los
            aspectos Administrativos, Jurídicos y Técnicos de las copropiedades.
          </p>
          <p class="text-neutral-600 leading-relaxed mb-8">
            Hemos conformado un grupo profesional interdisciplinario en las áreas de Administración de
            Empresas, Derecho, Contaduría Pública e Ingeniería eléctrica, sanitaria y civil, para
            adelantar con plena idoneidad el proceso de evaluación del estado de construcción de las
            zonas comunes de las copropiedades.
          </p>
          <a
            href="/quienes-somos"
            class="inline-flex items-center gap-2 text-brand-800 font-semibold hover:text-brand-600 transition-colors group"
          >
            Conocer más sobre nosotros
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Right: brand words panel -->
        <div class="bg-brand-800 rounded-2xl p-10">
          {['Experiencia', 'Rigurosidad', 'Cumplimiento'].map((word, i) => (
            <div class:list={[
              'flex items-center gap-6 py-7',
              i < 2 ? 'border-b border-brand-700' : ''
            ]}>
              <span class="font-heading text-accent-500/40 text-5xl font-bold leading-none select-none w-12 text-right shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="w-px h-10 bg-brand-600 shrink-0"></div>
              <span class="font-heading text-white text-2xl font-semibold">{word}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section class="py-24 bg-brand-800 relative overflow-hidden">
    <div class="hero-pattern absolute inset-0 pointer-events-none"></div>
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full bg-accent-500 opacity-[0.04] blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-white text-4xl sm:text-5xl font-bold mb-5 leading-tight">
        ¿Necesita asesoría en<br />
        <span class="text-accent-500">Propiedad Horizontal</span>?
      </h2>
      <p class="text-neutral-300 text-lg mb-10 max-w-xl mx-auto">
        Contáctenos hoy y reciba orientación de nuestro equipo especializado.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contacto"
          class="px-8 py-4 bg-accent-500 text-brand-900 font-semibold rounded hover:bg-accent-400 transition-colors"
        >
          Agendar consulta
        </a>
        <a
          href="https://wa.me/57"
          class="px-8 py-4 border border-white/60 text-white font-semibold rounded hover:bg-brand-700 hover:border-white transition-colors inline-flex items-center gap-2.5"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 24px,
      rgba(255, 255, 255, 0.025) 24px,
      rgba(255, 255, 255, 0.025) 25px
    );
  }
</style>
