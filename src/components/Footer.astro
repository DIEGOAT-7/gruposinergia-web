---
const services = [
  'Recibo de Zonas Comunes',
  'Derecho Urbano',
  'Derecho Inmobiliario',
  'Asesoría en Propiedad Horizontal',
  'Reglamento de Propiedad Horizontal',
  'Responsabilidad Civil',
]

const WA_NUMBER = '573147905889'
const year = new Date().getFullYear()
---

<footer class="bg-brand-950 text-neutral-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Columna 1: Identidad -->
      <div>
        <p class="font-heading text-white text-xl font-bold mb-1">Grupo Sinergia</p>
        <p class="text-xs tracking-widest uppercase text-neutral-400 mb-4">Consultores S.A.S.</p>
        <p class="text-sm leading-relaxed text-neutral-400">
          Especialistas en Propiedad Horizontal con más de 15 años de experiencia.
          Asesoría jurídica, técnica y administrativa a nivel nacional.
        </p>
        <p class="text-xs text-neutral-500 mt-4">NIT: 901426445-1</p>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Servicios</h3>
        <ul class="space-y-2">
          {services.map(s => (
            <li>
              <a href="/servicios" class="text-sm text-neutral-400 hover:text-accent-500 transition-colors">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              Calle 18 #106-100<br/>
              C.C. Ciudad Jardín, Ofic. 204<br/>
              Cali, Colombia
            </span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:sinergiaci@yahoo.com" class="hover:text-accent-500 transition-colors">
              sinergiaci@yahoo.com
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <a
              href={`https://wa.me/${WA_NUMBER}?text=Hola%2C%20necesito%20asesor%C3%ADa%20en%20Propiedad%20Horizontal.`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent-500 transition-colors"
            >
              +57 314 790 5889
            </a>
          </li>
        </ul>

        <a
          href="/contacto"
          class="inline-block mt-6 px-5 py-2.5 rounded bg-accent-500 text-brand-900 text-sm font-semibold hover:bg-accent-400 transition-colors"
        >
          Solicitar asesoría
        </a>
      </div>
    </div>

    <!-- Empresa aliada -->
    <div class="border-t border-brand-800 mt-10 pt-8">
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-neutral-500 mb-5">Empresa aliada</p>
      <a
        href="https://www.agudeloygutierrezingenieria.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block opacity-60 hover:opacity-100 transition-opacity"
        aria-label="Agudelo y Gutiérrez Ingeniería"
      >
        <img
          src="/logo_empresa_aliada.svg"
          alt="Agudelo y Gutiérrez Ingeniería"
          class="h-12 w-auto"
        />
      </a>
    </div>

    <div class="border-t border-brand-800 mt-8 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-neutral-500">
      <p>© {year} Grupo Sinergia Consultores S.A.S. Todos los derechos reservados.</p>
      <p>Cali, Colombia — Operación nacional</p>
    </div>
  </div>
</footer>
