---
const services = [
  'Recibo de Zonas Comunes',
  'Derecho Urbano',
  'Derecho Inmobiliario',
  'Asesoría en Propiedad Horizontal',
  'Reglamento de Propiedad Horizontal',
  'Responsabilidad Civil',
]

const year = new Date().getFullYear()
---

<footer class="bg-brand-950 text-neutral-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Columna 1: Identidad -->
      <div>
        <p class="font-heading text-white text-xl font-bold mb-1">Grupo Sinergia</p>
        <p class="text-xs tracking-widest uppercase text-neutral-400 mb-4">Consultores S.A.S.</p>
        <p class="text-sm leading-relaxed text-neutral-400">
          Especialistas en Propiedad Horizontal con más de 15 años de experiencia.
          Asesoría jurídica, técnica y administrativa a nivel nacional.
        </p>
        <p class="text-xs text-neutral-500 mt-4">NIT: 901426445-1</p>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Servicios</h3>
        <ul class="space-y-2">
          {services.map(s => (
            <li>
              <a href="/servicios" class="text-sm text-neutral-400 hover:text-accent-500 transition-colors">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contacto</h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Cali, Colombia
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:sinergiaci@yahoo.com" class="hover:text-accent-500 transition-colors">
              sinergiaci@yahoo.com
            </a>
          </li>
        </ul>

        <a
          href="/contacto"
          class="inline-block mt-6 px-5 py-2.5 rounded bg-accent-500 text-brand-900 text-sm font-semibold hover:bg-accent-400 transition-colors"
        >
          Solicitar asesoría
        </a>
      </div>
    </div>

    <div class="border-t border-brand-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-neutral-500">
      <p>© {year} Grupo Sinergia Consultores S.A.S. Todos los derechos reservados.</p>
      <p>Cali, Colombia — Operación nacional</p>
    </div>
  </div>
</footer>
